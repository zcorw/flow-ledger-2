APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://flow_ledger:flow_ledger@postgres:5432/flow_ledger
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-one-time-random-token
BASE_CURRENCY=CNY
CURRENCY_LIMIT=5
FX_SYNC_TIME=08:00
TZ=Asia/Tokyo
BACKUP_DIR=/var/backups/flow-ledger
LOG_DIR=/var/log/flow-ledger
POSTGRES_DB=flow_ledger
POSTGRES_USER=flow_ledger
POSTGRES_PASSWORD=flow_ledger
VITE_API_BASE_URL=/api/v1
