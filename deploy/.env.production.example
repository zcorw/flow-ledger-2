APP_ENV=production
APP_BASE_URL=https://ledger.example.com
PROXY_MODE=caddy

# Required only when PROXY_MODE=caddy.
DOMAIN=ledger.example.com
ACME_EMAIL=admin@example.com

DATABASE_URL=postgresql+psycopg://flow_ledger:replace-with-url-encoded-password@postgres:5432/flow_ledger
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-one-time-random-token
BASE_CURRENCY=CNY
CURRENCY_LIMIT=5
FX_SYNC_TIME=08:00
TZ=Asia/Tokyo
POSTGRES_DB=flow_ledger
POSTGRES_USER=flow_ledger
POSTGRES_PASSWORD=replace-with-a-random-database-password
BACKUP_RETENTION_DAYS=14
BACKUP_CRON="0 2 * * *"
BACKUP_ON_START=false

# Deployment resource safeguards. Set either threshold to 0 to disable that check.
COMPOSE_PARALLEL_LIMIT=1
DEPLOY_MIN_AVAILABLE_MEMORY_MB=1024
DEPLOY_MIN_DOCKER_FREE_MB=4096
DEPLOY_PRUNE_ENABLED=true
DEPLOY_PRUNE_UNTIL=168h

# Used only when PROXY_MODE=caddy; both values have the shown defaults.
HTTP_PORT=80
HTTPS_PORT=443

# Used only when PROXY_MODE=external; defaults to 18080.
EXTERNAL_PROXY_PORT=18080

# Optional in either mode. External mode otherwise checks its loopback endpoint.
# HEALTHCHECK_URL=https://ledger.example.com/api/v1/system/health
