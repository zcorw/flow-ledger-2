APP_ENV=production
APP_BASE_URL=https://ledger.example.com
DOMAIN=ledger.example.com
ACME_EMAIL=admin@example.com
DATABASE_URL=postgresql+psycopg://flow_ledger:replace-with-url-encoded-password@postgres:5432/flow_ledger
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-one-time-random-token
BASE_CURRENCY=CNY
CURRENCY_LIMIT=5
FX_SYNC_TIME=08:00
TZ=Asia/Tokyo
POSTGRES_DB=flow_ledger
POSTGRES_USER=flow_ledger
POSTGRES_PASSWORD=replace-with-a-random-database-password
BACKUP_RETENTION_DAYS=14
BACKUP_CRON="0 2 * * *"
HTTP_PORT=80
HTTPS_PORT=443
