http://{$DOMAIN} {
  encode zstd gzip

  @api path /api/*
  reverse_proxy @api backend:8000
  reverse_proxy frontend:80

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output file /var/log/caddy/access.log
    format json
  }
}
